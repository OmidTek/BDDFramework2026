<suite name="Cross Browser Suite">
<!-- run from cmd  sample   mvn clean test -Dbrowser=chrome
 mvn clean test -Dbrowser=chrome -Denv=qa -Dusername=Omid
 second point choose xml file

 mvn clean test -Dsurefire.suiteXmlFiles=testTwoBrowser.xml



 -->




    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="base.BrowserContext">
              <!--  <methods>   this optional because we have one method with @Test
                    <include name="setBrowser"/>
                </methods>-->
            </class>
            <class name="runners.TestRunner"/>
        </classes>
    </test>


    <test name="Edge Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="base.BrowserContext">
                <!--<methods>
                    <include name="setBrowser"/>
                </methods> -->
            </class>
            <class name="runners.TestRunner"/>
        </classes>
    </test>


    <test name="Rerun Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="base.BrowserContext"/>
            <class name="runners.FailedTestRunner"/>
        </classes>
    </test>

    <test name="Rerun edge Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="base.BrowserContext"/>
            <class name="runners.FailedTestRunner"/>
        </classes>
    </test>

</suite>